{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "moa-member-signup",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "member-project",
      "database_id": "e003386a-7cb8-4e99-a69e-3f29885ec384",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
